# =============================================================================
#  OPCIONAL: o docker-compose.yml já tem estes mesmos valores como default.
#  Crie um .env (cp .env.example .env) apenas para SOBRESCREVER algo — o .env é ignorado pelo Git.
#  Valores EXCLUSIVOS para desenvolvimento local. Gere uma chave nova com:
#    ./scripts/generate-jwt-keys.sh
# =============================================================================
RABBITMQ_USER=fcg
RABBITMQ_PASSWORD=fcg_dev_pwd

USERS_DB_PASSWORD=users_dev_pwd
CATALOG_DB_PASSWORD=catalog_dev_pwd
PAYMENTS_DB_PASSWORD=payments_dev_pwd

ADMIN_EMAIL=admin@fcg.local
ADMIN_PASSWORD=Admin@12345

# Compras acima deste valor são recusadas pelo gateway simulado do PaymentsAPI.
PAYMENT_MAX_APPROVED_AMOUNT=300.00

# Chave privada RSA do JWT (PKCS#8, DER, Base64 em uma linha). Só o UsersAPI recebe esta variável.
# NÃO versione chave privada: este arquivo é um modelo. Gere uma com ./scripts/generate-jwt-keys.sh
# e cole o valor apenas no seu .env (ignorado pelo Git). Sem ela, o compose usa a chave de desenvolvimento.
# JWT_PRIVATE_KEY=
